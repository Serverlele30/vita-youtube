# Vorlage fuer /etc/vita-youtube.env (chmod 600, gehoert root) – echte Werte NIE ins Git
YT_API_KEY=
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
# YT_OAUTH_SCOPE=https://www.googleapis.com/auth/youtube
VITA_YT_PLAY_BASE=http://127.0.0.1:8090
# Standardwerte, nur bei Bedarf aendern:
# VITA_YT_PUBLIC_BASE=https://ytv.serverlele.de
# VITA_YT_HOST=127.0.0.1
# VITA_YT_PORT=8444
# VITA_YT_REGION=DE
# VITA_YT_DB=/var/lib/vita-youtube/accounts.db
# VITA_YT_REQLOG=/var/log/vita-yt-requests.log
# Nur zur Fehlersuche:
# VITA_YT_DUMP=/var/lib/vita-youtube/dump
