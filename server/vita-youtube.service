[Unit]
Description=PS Vita YouTube Adapter (GData v2.1 -> YouTube Data API v3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/vita-youtube.env
ExecStart=/usr/bin/python3 /opt/vita-youtube/adapter.py
Restart=always
RestartSec=2
StateDirectory=vita-youtube

[Install]
WantedBy=multi-user.target
